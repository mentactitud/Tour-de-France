rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para colecciones privadas de usuario (jornadas y gastos)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para cazadores activos en tiempo real en el coto (posiciones GPS)
    match /liveHunters/{hunterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == hunterId;
    }

    // Por defecto, denegar cualquier otro acceso no autorizado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
